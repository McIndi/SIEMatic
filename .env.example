# Example .env file for SIEMatic Docker Compose
# Copy to .env and fill in values

# Required for security
DJANGO_SECRET_KEY=

# Database (Postgres for Docker)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=siematic
DATABASE_USER=siematic
DATABASE_PASSWORD=
DATABASE_HOST=siematic-db
DATABASE_PORT=5432

CHERRYPY_PORT=8000
CHERRYPY_HOST=0.0.0.0


# Optional
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=siematic-indexer,siematic-web,localhost,127.0.0.1

# Set to True when the app is served over TLS (enables HSTS, secure cookies, SSL redirect)
# HTTPS_ENABLED=True

# For agent service
INDEXER_USERNAME=siematic
INDEXER_PASSWORD=
INDEXER_HOSTNAME=siematic-indexer
INDEXER_PORT=5001
