# Example .env file for SIEMatic Docker Compose
# Copy to .env and fill in values

# Required for security
DJANGO_SECRET_KEY=

# Database (Postgres for Docker)
DATABASE_NAME=siematic
DATABASE_USER=siematic
DATABASE_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432

# Optional
DJANGO_DEBUG=False
ALLOWED_HOSTS=web,localhost,127.0.0.1

# For agent service
INDEXER_USERNAME=
INDEXER_PASSWORD=