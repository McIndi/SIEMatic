# Example .env file for SIEMatic Docker Compose
# Copy to .env and fill in values
# Generate DJANGO_SECRET_KEY with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Required for security
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret-key

# Database (Postgres for Docker)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=siematic
DATABASE_USER=siematic
DATABASE_PASSWORD=
DATABASE_HOST=siematic-db
DATABASE_PORT=5432

CHERRYPY_PORT=8000
CHERRYPY_HOST=0.0.0.0
CHERRYPY_SSL=True
CHERRYPY_SSL_CERT=certs/siematic.crt
CHERRYPY_SSL_KEY=certs/siematic.key


# Optional
DJANGO_DEBUG=False
# Generate these gitignored development files with:
# python tools/gen_dev_cert.py
SIEMATIC_TLS_ENABLED=True
DJANGO_ALLOWED_HOSTS=siematic-indexer,siematic-web,localhost,127.0.0.1
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=siematic@example.com

# For agent service
INDEXER_USERNAME=siematic
INDEXER_PASSWORD=
INDEXER_HOSTNAME=siematic-indexer
INDEXER_PORT=5001
INDEXER_TLS=True
INDEXER_SSL_CERT=certs/siematic.crt
INDEXER_SSL_KEY=certs/siematic.key
# Trust bundle used by both HTTPS login and WSS ingestion.
INDEXER_CA_BUNDLE=certs/siematic.crt
